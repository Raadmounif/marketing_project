APP_NAME="Puff Plaza"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://puffplaza.com/api
FRONTEND_URL=https://puffplaza.com

# Optional: full base URL for storage/app/public files (default APP_URL/public/storage). Use if images 404.
PUBLIC_STORAGE_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tobacco_market
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_gmail@gmail.com
MAIL_FROM_NAME="Puff Plaza"

NOTIFICATION_EMAIL=raadmunif2@gmail.com

SANCTUM_STATEFUL_DOMAINS=puffplaza.com,www.puffplaza.com,localhost
