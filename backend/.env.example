# =============================================================================
# Puff Plaza — Laravel backend (.env)
# Copy to ".env" and fill values. Never commit ".env".
# This file documents BOTH local development and production (cPanel).
# =============================================================================

APP_NAME="Puff Plaza"
APP_KEY=
LOG_CHANNEL=stack
LOG_LEVEL=debug

# APP_ENV=local for development; production on the server
APP_ENV=production
APP_DEBUG=false

# -----------------------------------------------------------------------------
# URLs — pick ONE block (local vs production)
# -----------------------------------------------------------------------------
# --- Local development (php artisan serve + Vite) ---
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://127.0.0.1:8000
# FRONTEND_URL=http://localhost:5173
# Optional if Vite uses another port (e.g. 5174): set FRONTEND_URL to match the browser origin.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174,127.0.0.1:8000

# --- Production (cPanel / HTTPS) — example host ---
APP_ENV=production
APP_URL=https://puffplaza.com/api
FRONTEND_URL=https://puffplaza.com
SANCTUM_STATEFUL_DOMAINS=puffplaza.com,www.puffplaza.com,localhost

# Optional: absolute base for /storage URLs if different from APP_URL/public/storage
PUBLIC_STORAGE_URL=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tobacco_market
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Mail (Gmail example; use cPanel SMTP in production if preferred)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_gmail@gmail.com
MAIL_FROM_NAME="Puff Plaza"

# Legacy / optional — notification recipient is also stored in DB settings (admin UI).
NOTIFICATION_EMAIL=raadmunif2@gmail.com

# Optional: Resend API fallback for transactional email (see OrderController).
# RESEND_API_KEY=
