# Copy to .env and fill in secrets. Never commit .env.
# This file is for cPanel / SSH deploy scripts under deploy/.
# For local development, use backend/.env.example and frontend/.env.example instead.

# --- deploy-cpanel.mjs (frontend only) ---
DEPLOY_CONFIRM=YES_DEPLOY
# Production build (default):
VITE_API_URL=https://puffplaza.com/api
# Local test build against artisan serve (uncomment if needed):
# VITE_API_URL=http://127.0.0.1:8000/api

# --- deploy-full.mjs (frontend + Laravel + SSH composer/artisan) ---
FULL_DEPLOY_CONFIRM=YES_FULL_DEPLOY
SSH_PORT=21098

# cPanel MySQL (from cPanel → MySQL Databases) — required for migrate/seed
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional mail overrides for production .env
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# NOTIFICATION_EMAIL=

SFTP_HOST=ftp.puffplaza.com
SFTP_PORT=21098
SFTP_USER=your_cpanel_user
SFTP_PASSWORD=
SFTP_REMOTE_PATH=/home/your_cpanel_user/public_html

# Optional: Laravel image URLs (advertising board, products). Default APP_URL/public/storage
# PUBLIC_STORAGE_URL=https://puffplaza.com/api/public/storage

# --- clean-cpanel.mjs (optional) ---
# CLEAN_CONFIRM=YES_DELETE_ALL
