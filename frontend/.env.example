# =============================================================================
# Puff Plaza — Vite frontend (.env)
# Copy to ".env" for local builds, or ".env.production" for production builds.
# Never commit real ".env" files.
# =============================================================================

# -----------------------------------------------------------------------------
# Local development (Laravel on :8000, Vite on :5173 or :5174)
# -----------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000/api
# VITE_STORAGE_URL=http://localhost:8000/storage

# -----------------------------------------------------------------------------
# Production (cPanel — API served under /api)
# -----------------------------------------------------------------------------
VITE_API_URL=https://puffplaza.com/api
VITE_STORAGE_URL=https://puffplaza.com/api/public/storage
